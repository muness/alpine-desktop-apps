39b0113dc1174334ebd5b59176af175f208078164bfc990c0d84530eca78f4ef9b0ba6f8bc0f639b3b2348e85226f29e77a0919b950822c288ff10199f7da180  obsidian
0177ee17403b782e7e2abcdb550d64c3dac4fbfadbd7aa8b58b1b82cdef7bfebea9c4cf73cdde30743670bb03429f7f80015c3532090ccfb7039458f67383c3d  obsidian.desktop
"
