# Maintainer: Muness Castle <931+muness@users.noreply.github.com>
pkgname=obsidian-glibc-experimental
pkgver=1.14.5
pkgrel=0
pkgdesc="Obsidian ARM64 addon for the experimental desktop runtime"
url="https://obsidian.md"
arch="aarch64"
license="custom"
depends="glibc-desktop-apps-experimental>=20261025-r1"
options="!check !strip !tracedeps"
source="obsidian-$pkgver-arm64.tar.gz::https://github.com/obsidianmd/obsidian-releases/releases/download/v$pkgver/obsidian-$pkgver-arm64.tar.gz
	obsidian
	obsidian.desktop"
builddir="$srcdir/obsidian-$pkgver-arm64"

package() {
	local app="$pkgdir/usr/lib/desktop-apps-runtime/opt/obsidian"
	mkdir -p "$app"
	cp -a "$builddir"/. "$app/"
	chown -R root:root "$app"
	find "$app" -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s \{\} \;
	test -x "$app/obsidian"
	test -f "$app/resources/icon.png"
	install -Dm755 "$srcdir/obsidian" "$pkgdir/usr/bin/obsidian"
	install -Dm644 "$srcdir/obsidian.desktop" "$pkgdir/usr/share/applications/obsidian.desktop"
}

sha512sums="
